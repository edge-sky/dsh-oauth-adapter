exports[`OAuth footer in the actual DSH rc Models page > registers once, pre-fills a pending model and saves its selected protocol 1`] = `"<article class="dsh-oauth-model-provider"><h3>GitHub Copilot (OAuth)</h3><p>Connected · Account-synchronized list</p><p>Matched: 0 · Needs configuration: 0 · Manual: 1</p><button>Synchronize models</button><button>Add model</button><section aria-label="Manual"><h4>Manual</h4><ul class="dsh-oauth-model-list"><li><div><strong>Future model</strong> <code>future-model</code> <span>Manual</span></div><button>Edit</button><button>Delete manual entry</button></li></ul></section></article>"`;

exports[`OAuth footer in the actual DSH rc Models page > renders Chinese discovery failure independently from the connected account state 1`] = `"<article class="dsh-oauth-model-provider"><h3>GitHub Copilot (OAuth)</h3><p>已连接 · 已同步账号列表</p><p>已匹配: 0 · 待配置: 1 · 手动模型: 0</p><div role="alert"><p>模型操作失败，请查看详情后重试。</p><details><summary>技术详情</summary>Model discovery returned HTTP 403.</details></div><button>同步模型</button><button>手动添加</button><section aria-label="待配置"><h4>待配置</h4><ul class="dsh-oauth-model-list"><li><div><strong>Future model</strong> <code>future-model</code> <span>待配置</span></div><button>补充配置</button></li></ul></section></article>"`;
