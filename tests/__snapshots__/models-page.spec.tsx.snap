// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`OAuth footer in the actual DSH rc Models page > registers once, hides pending models and saves a manual model with its selected protocol 1`] = `"<article class="dsh-oauth-model-provider"><div class="dsh-oauth-model-header"><h3 class="dsh-oauth-name">GitHub Copilot (OAuth)</h3><button class="dsh-oauth-button" type="button" aria-expanded="true" aria-controls="dsh-oauth-models-github-copilot">Collapse</button></div><div class="dsh-oauth-model-details" id="dsh-oauth-models-github-copilot"><p class="dsh-oauth-muted">Connected · Account-synchronized list</p><p class="dsh-oauth-muted">Automatic matches: 0 · Manual: 1</p><div class="dsh-oauth-model-actions"><button class="dsh-oauth-button">Synchronize models</button><button class="dsh-oauth-button">Add model</button></div><section class="dsh-oauth-model-group" aria-label="Manual"><h4>Manual</h4><ul class="dsh-oauth-model-list"><li><div class="dsh-oauth-model-identity"><strong>future-model</strong><code>future-model</code></div><div class="dsh-oauth-model-actions"><button class="dsh-oauth-button">Edit</button><button class="dsh-oauth-button" data-variant="danger">Delete manual entry</button></div></li></ul></section><section class="dsh-oauth-model-group" aria-label="Automatic matches"><h4>Automatic matches</h4><ul class="dsh-oauth-model-list"></ul><p class="dsh-oauth-muted">No models in this group.</p></section></div></article>"`;

exports[`OAuth footer in the actual DSH rc Models page > renders Chinese discovery failure independently from the connected account state 1`] = `"<article class="dsh-oauth-model-provider"><div class="dsh-oauth-model-header"><h3 class="dsh-oauth-name">GitHub Copilot (OAuth)</h3><button class="dsh-oauth-button" type="button" aria-expanded="true" aria-controls="dsh-oauth-models-github-copilot">收起</button></div><div class="dsh-oauth-model-details" id="dsh-oauth-models-github-copilot"><p class="dsh-oauth-muted">已连接 · 已同步账号列表</p><p class="dsh-oauth-muted">自动匹配: 0 · 手动配置: 0</p><div class="dsh-oauth-error" role="alert"><p>模型操作失败，请查看详情后重试。</p><details><summary>技术详情</summary>Model discovery returned HTTP 403.</details></div><div class="dsh-oauth-model-actions"><button class="dsh-oauth-button">同步模型</button><button class="dsh-oauth-button">手动添加</button></div><section class="dsh-oauth-model-group" aria-label="手动配置"><h4>手动配置</h4><ul class="dsh-oauth-model-list"></ul><p class="dsh-oauth-muted">此分组暂无模型。</p></section><section class="dsh-oauth-model-group" aria-label="自动匹配"><h4>自动匹配</h4><ul class="dsh-oauth-model-list"></ul><p class="dsh-oauth-muted">此分组暂无模型。</p></section></div></article>"`;
