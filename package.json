{
  "name": "@edge-sky/dsh-oauth-adapter",
  "description": "Web OAuth account surface for official DSH authorization flows",
  "version": "0.1.3-rc.1",
  "author": {
    "name": "edge-sky",
    "url": "https://github.com/edge-sky"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edge-sky/dsh-oauth-adapter.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./authorization-fallback": {
      "types": "./lib/authorization-fallback.d.ts",
      "default": "./lib/authorization-fallback.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:host && pnpm run build:client:types",
    "build:host": "tsc -p tsconfig.json",
    "build:client:types": "tsc -p tsconfig.client.json",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepack": "pnpm run typecheck && pnpm test"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-authorization": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <0.1.6-0",
    "react": ">=18.2.0",
    "@deepseek-ai/dsh-client-ui-settings-models": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-fs": ">=0.1.5-rc.2 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.2 <0.1.6-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-models": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "ws": "^8.18.3",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings-file": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "jsdom": "^26.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "clsx": "^2.0.0",
    "anser": "^2.3.5",
    "shiki": "^4.3.1",
    "@shikijs/langs": "^4.3.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "katex": "^0.16.47",
    "zustand": "~4.4.7",
    "immer": "^10.1.1"
  }
}
